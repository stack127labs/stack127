[Unit]
Description=Refresh stack127 ad network %i data
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/data/projects/stack127
Environment=AD_NETWORK_DB_PATH=%h/.local/share/stack127/ad-networks.sqlite
Environment=NODE_NO_WARNINGS=1
# Each job has one owner. Other jobs can run with their shared host limiter.
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 0 %t/stack127-ad-network-%i.lock /usr/bin/node --experimental-strip-types scripts/ad-networks/refresh.mjs --job %i --environment development --apply
TimeoutStartSec=infinity
TimeoutStopSec=120
KillMode=control-group
Nice=10
