[Unit]
Description=stack127 ad network publisher discovery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/data/projects/stack127
Environment=AD_NETWORK_DB_PATH=%h/.local/share/stack127/ad-networks.sqlite
Environment=NODE_NO_WARNINGS=1
Environment=AD_NETWORK_FETCH_THROTTLE_DB=%h/.local/state/stack127/ad-networks/fetch-throttle.sqlite
ExecStart=/usr/bin/node scripts/ad-networks/worker.mjs --role discovery --once
Nice=10
