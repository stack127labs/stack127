[Unit]
Description=Back up the stack127 local ad network database

[Service]
Type=oneshot
WorkingDirectory=/srv/data/projects/stack127
Environment=AD_NETWORK_DB_PATH=%h/.local/share/stack127/ad-networks.sqlite
Environment=NODE_NO_WARNINGS=1
ExecStart=/usr/bin/node scripts/ad-networks/backup-local.mjs --backup-directory /srv/data/backups/stack127-ad-networks --keep 7
Nice=15
