[Unit]
Description=stack127 ad network publisher verification worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/data/projects/stack127
Environment=AD_NETWORK_DB_PATH=%h/.local/share/stack127/ad-networks.sqlite
Environment=NODE_NO_WARNINGS=1
Environment=UV_THREADPOOL_SIZE=128
Environment=AD_NETWORK_FETCH_THROTTLE_DB=%h/.local/state/stack127/ad-networks/fetch-throttle.sqlite
ExecStart=/usr/bin/node scripts/ad-networks/worker.mjs --role verification --concurrency 12 --limit 2500
Restart=always
RestartSec=30
TimeoutStopSec=90
KillMode=control-group
Nice=10

[Install]
WantedBy=default.target
