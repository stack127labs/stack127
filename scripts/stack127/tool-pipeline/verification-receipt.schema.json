{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stack127.com/schemas/tool-verification-receipt-v1.json",
  "title": "stack127 tool verification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "route", "risk", "status", "generatedAt", "baseCommit", "publicationState", "spec", "checks", "review"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "route": { "type": "string", "pattern": "^/[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "risk": { "enum": ["simple", "standard", "high"] },
    "status": { "enum": ["accepted", "blocked"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "publicationState": { "enum": ["published", "unpublished", "noindex"] },
    "spec": { "$ref": "#/$defs/path" },
    "checks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "status", "durationMs"],
        "properties": {
          "name": { "enum": ["fast", "browser", "build"] },
          "command": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
  }
}
