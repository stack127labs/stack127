[Unit]
Description=Process the Stack127 cache revalidation queue
Wants=network-online.target
After=network-online.target
ConditionPathExists=/srv/stack127-data/cache-worker.env

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/stack127
ExecStart=/srv/stack127/scripts/stack127/cache/ovh/run-worker.sh
TimeoutStartSec=125
TimeoutStopSec=5
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/stack127-data
StandardOutput=journal
StandardError=journal
